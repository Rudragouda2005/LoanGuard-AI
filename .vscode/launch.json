{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run LoanGuard AI (Full App)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Train ML Models",
      "type": "debugpy",
      "request": "launch",
      "module": "backend.ml_pipeline",
      "justMyCode": true
    }
  ]
}
